# Supabase (same project the web app uses — anon key is safe to ship)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# ATLAS API base. Leave UNSET in dev: Expo Go derives the LAN host from the
# dev server automatically. REQUIRED and HTTPS for staging/production builds,
# set through the EAS environment rather than a developer-local file, e.g.
# https://api.atlas.example.com
EXPO_PUBLIC_API_URL=
