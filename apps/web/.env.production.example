# ---------------------------------------------------------------------------
# apps/web production environment
#
# NEXT_PUBLIC_ROOT_DOMAIN is the single switch that turns the host split on.
# Set it in Production ONLY. Leave it EMPTY in Preview and locally, or every
# preview deployment redirects its own app routes at production and becomes
# untestable (see lib/hosts.ts).
#
# With it set:
#   atlasgo.co.tz        -> marketing surface
#   www.atlasgo.co.tz    -> marketing surface
#   app.atlasgo.co.tz    -> the product
#
# It is ALSO what makes SEO correct. metadataBase, every canonical URL, the
# sitemap and the og:image URLs are all built from it. Unset, they fall back to
# http://localhost:3000 and the live site publishes localhost canonicals.
#
# Apex, no scheme, no www, no trailing slash.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ROOT_DOMAIN=atlasgo.co.tz

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=https://api.atlasgo.co.tz
