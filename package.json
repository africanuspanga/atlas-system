{
  "name": "atlas",
  "private": true,
  "version": "0.1.0",
  "description": "ATLAS — Tanzania-first school management SaaS platform",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "brace-expansion@1": "1.1.17",
      "brace-expansion@2": "2.1.3",
      "brace-expansion@5": "5.0.8",
      "@hono/node-server": "2.0.10",
      "fast-uri@3": "3.1.4",
      "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
      "multer": ">=2.2.0",
      "postcss": ">=8.5.18",
      "sharp": "0.35.3",
      "uuid@7": "11.1.1"
    }
  }
}
